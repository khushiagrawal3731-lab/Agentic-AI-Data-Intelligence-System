    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results || [];\n\nconst summary = results.map((r, i) => \n`${i + 1}. ${r.title}\n\n${r.content || r.description}\n\nSource: ${r.url}`\n).join(\"\\n\\n\");\n\nreturn [\n{\njson: {\ntext: summary\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        112
      ],
      "id": "16e8a4f8-04fc-42e7-8f0c-2b58a414af15",
      "name": "Parse Search Results"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text || \"\";\n\n// Clean raw text\nlet cleaned = text\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\t/g, \" \")\n  .replace(/#{1,6}\\s?/g, \"\")\n  .replace(/\\*\\*/g, \"*\")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\n// Add spacing before headings\ncleaned = cleaned\n  .replace(/Key Trends/g, \"\\n\\n*Key Trends*\")\n  .replace(/Key Findings/g, \"\\n\\n*Key Findings*\")\n  .replace(/Potential Trends/g, \"\\n\\n*Potential Trends*\")\n  .replace(/Applications/g, \"\\n\\n*Applications*\")\n  .replace(/Industry Insights/g, \"\\n\\n*Industry Insights*\")\n  .replace(/Recommendations/g, \"\\n\\n*Recommendations*\")\n  .replace(/Conclusion/g, \"\\n\\n*Conclusion*\");\n\n// Convert bullet styles\ncleaned = cleaned\n  .replace(/^- /gm, \"• \")\n  .replace(/^\\* /gm, \"• \");\n\n// Final cleanup\ncleaned = cleaned\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\nreturn [\n{\n  json: {\n    text: cleaned\n  }\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
