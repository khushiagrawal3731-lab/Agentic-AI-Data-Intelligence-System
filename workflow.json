        "jsonBody": "={\n  \"api_key\": \"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\",\n  \"query\": \"{{ $('Trigger').item.json.chatInput }}\",\n  \"search_depth\": \"advanced\",\n  \"max_results\": 5\n}",
